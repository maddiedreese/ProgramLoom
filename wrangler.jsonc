{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "programloom",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/embed/*"],
  },
  "routes": [
    { "pattern": "programloom.com", "custom_domain": true },
    { "pattern": "app.programloom.com", "custom_domain": true },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "programloom-production",
      "database_id": "87ce4c4c-82ae-451a-9134-8453eda45d71",
      "migrations_dir": "migrations",
    },
  ],
  "ai": { "binding": "AI" },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "programloom-files",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "programloom-jobs",
      },
    ],
    "consumers": [
      {
        "queue": "programloom-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
      },
    ],
  },
  "triggers": { "crons": ["*/10 * * * *", "0 3 * * *"] },
  "vars": {
    "APP_ENV": "production",
    "APP_URL": "https://app.programloom.com",
    "MARKETING_URL": "https://programloom.com",
    "EMAIL_FROM": "ProgramLoom <notifications@mail.programloom.com>",
    "EMAIL_REPLY_TO": "notifications@mail.programloom.com",
  },
}
